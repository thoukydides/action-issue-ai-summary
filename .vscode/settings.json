{
    "files.eol": "\n",
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "editor.rulers": [
        80
    ],
    "eslint.enable": true,
    "cSpell.words": [
        "aeiou",
        "buymeacoffee",
        "color",
        "dosubot",
        "Homebridge",
        "labeled",
        "Math",
        "Matterbridge",
        "MQTT",
        "onwarn",
        "scannable",
        "Segmenter",
        "Thoukydides",
        "tiktoken",
        "vars"
    ],
    "files.exclude": {
        "node_modules/": true
    },
    "typescript.tsdk": "node_modules/typescript/lib"
}